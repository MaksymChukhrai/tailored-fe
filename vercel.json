{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tailored-be-production.up.railway.app/:path*"
    },
    {
      "source": "/auth/google",
      "destination": "https://tailored-be-production.up.railway.app/auth/google"
    },
    {
      "source": "/auth/google/callback",
      "destination": "https://tailored-be-production.up.railway.app/auth/google/callback"
    },
    {
      "source": "/((?!api/|auth/google).*)",
      "destination": "/index.html"
    }
  ]
}
